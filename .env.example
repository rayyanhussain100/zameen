# Copy to .env and fill in. Never commit the real .env file.

# --- Postgres ---
# Full DSN used by the app (psycopg). Must point at a pgvector-enabled Postgres
# (see docker-compose.yml, image pgvector/pgvector:pg16).
DATABASE_URL=postgresql://zameen:zameen@localhost:5432/zameen

# Values used by docker-compose.yml to initialise the container.
POSTGRES_USER=zameen
POSTGRES_PASSWORD=zameen
POSTGRES_DB=zameen

# --- Google (ADK agent + embeddings) ---
# API key for Gemini (agent model) and gemini-embedding-001 (semantic search).
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Agent LLM. Any Gemini model ADK/your account can access.
ZAMEEN_AGENT_MODEL=gemini-2.0-flash

# Embedding model. text-embedding-004 has been retired from the Gemini API;
# gemini-embedding-001 is its replacement and is truncated to 768 dims (via
# output_dimensionality, see embeddings.py) to match the `vector(768)` column
# and HNSW index in db/schema.sql. Changing model/dimension requires
# migrating the column and rebuilding the index.
ZAMEEN_EMBEDDING_MODEL=gemini-embedding-001

# --- Scraper politeness ---
# Minimum seconds between requests to the same host, plus random jitter added
# on top (uniform 0..JITTER). Keep these conservative; Zameen.com's robots.txt
# and ToS should be checked before pointing this at the live site.
ZAMEEN_MIN_DELAY_SECONDS=3.0
ZAMEEN_JITTER_SECONDS=2.0
ZAMEEN_USER_AGENT=ZameenAgentBot/0.1 (+contact: you@example.com)
ZAMEEN_MAX_RETRIES=5

# --- SQL tool guardrail ---
# Hard cap applied to any SELECT that doesn't specify its own LIMIT.
ZAMEEN_SQL_TOOL_MAX_ROWS=200
